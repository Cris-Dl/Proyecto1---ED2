<Window x:Class="MundialWPF.RegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Jugador" Height="500" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#ECF0F1">

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="REGISTRAR JUGADOR" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nombre:" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" Margin="0,2,0,2"/>

                <TextBlock Text="Selección:" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSeleccion" Grid.Row="1" Grid.Column="1" Margin="0,2,0,2"/>

                <TextBlock Text="Posición:" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPosicion" Grid.Row="2" Grid.Column="1" Margin="0,2,0,2"/>

                <TextBlock Text="Minutos Jugados:" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBox x:Name="txtMinutos" Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" Text="0"/>

                <TextBlock Text="Goles:" Grid.Row="4" VerticalAlignment="Center"/>
                <TextBox x:Name="txtGoles" Grid.Row="4" Grid.Column="1" Margin="0,2,0,2" Text="0"/>

                <TextBlock Text="Asistencias:" Grid.Row="5" VerticalAlignment="Center"/>
                <TextBox x:Name="txtAsistencias" Grid.Row="5" Grid.Column="1" Margin="0,2,0,2" Text="0"/>

                <TextBlock Text="Tarjetas:" Grid.Row="6" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTarjetas" Grid.Row="6" Grid.Column="1" Margin="0,2,0,2" Text="0"/>

                <TextBlock Text="Partidos:" Grid.Row="7" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPartidos" Grid.Row="7" Grid.Column="1" Margin="0,2,0,2" Text="0"/>
            </Grid>

            <Button Content="Guardar Jugador" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,20,0,10" Click="btnGuardar_Click"/>
            <Button Content="Cancelar" Height="35" Background="#E74C3C" Foreground="White" Click="btnCancelar_Click"/>
        </StackPanel>
    </Border>
</Window>